# Copy this file to .env and fill in real values. Never commit .env itself.
#
# If NONE of the keys below are set, reply generation runs in deterministic
# MOCK/TEMPLATE mode (built directly from retrieved evidence, no free-text LLM
# generation) and the whole project is fully runnable/testable without any key.
#
# Set ANY ONE of the following to enable live LLM generation. You are not
# locked into Anthropic -- pick whichever provider you have a key for.

# Option A: Anthropic (Claude models)
ANTHROPIC_API_KEY=

# Option B: OpenAI
OPENAI_API_KEY=

# Option C: ANY OpenAI-compatible endpoint (Groq, Together, Fireworks,
# Mistral's API, a local Ollama server via its OpenAI-compat shim, etc.)
# Both of these must be set together.
LLM_API_KEY=
LLM_BASE_URL=

# Optional: force a specific provider if you have multiple keys set above.
# One of: anthropic | openai | openai_compatible
# If unset, priority is: explicit override > ANTHROPIC_API_KEY > OPENAI_API_KEY > LLM_API_KEY
LLM_PROVIDER=

# Optional: model name/id to use. Sensible defaults are chosen per-provider
# if left unset (see src/llm_providers.py's DEFAULT_MODELS).
REPLY_GEN_MODEL=

# --- API layer (FastAPI + SQLAlchemy) ---
# Database URL, SQLAlchemy format. Defaults to a local SQLite file if unset.
# Swapping to PostgreSQL later needs ONLY this value changed, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/hiver_tickets
DATABASE_URL=
